
def longestPalindrome(words):
    # Composition: pair of mirrored and a dup
    mirPair = 0
    dup = {}
    for i in range(len(words)):
        if words[i][0] == words[i][1]:
            if words[i] not in dup.keys():
                dup[words[i]] = int(1)
            else:
                dup[words[i]] += 1
            words[i] = ''

    for i in range(len(words)):
        if words[i] != '':
            temp = words[i][1] + words[i][0]
            words[i] = ''
            for j in range(len(words)):
                if words[j] == temp:
                    words[j] = ''
                    mirPair += 1
    
    length = mirPair * 4
    middle = True
    for key in dup.keys():
        if dup[key] > 1 and dup[key] % 2 == 0:
            length += 4
        if dup[key] > 1 and dup
        if dup[key] == 1 and middle:
            middle = False
            length += 2
        
        
        return length
    
